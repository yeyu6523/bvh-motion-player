{
  "name": "bvh-motion-player",
  "version": "1.0.0",
  "description": "Offline BVH skeleton viewer with playback controls for Windows",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "yeyu6523",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "test:data": "node scripts/check-data.mjs",
    "test:desktop": "npm run build && electron . --smoke-test",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "io.github.yeyu6523.bvh-motion-player",
    "productName": "BVH Motion Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "BVH-Motion-Player-${version}-win-x64.${ext}",
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "overrides": { "minimatch": "^11.0.1" },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.7"
  }
}
